<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZombiePlague</AssemblyName>
    <RootNamespace>ZombiePlague</RootNamespace>
    <Description>Zombie Plague</Description>
    <Authors>maxrebhorn01</Authors>
    <Version>0.1.0</Version>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Compile-time-only references via NuGet instead of HintPath into a local
    Steam install. This is what makes the project buildable on any machine
    (and in CI) without owning/installing Bannerlord: these packages are
    metadata-only "reference assemblies" (or, for MCM, its own published
    build), never copied into the output (ExcludeAssets="runtime", mirroring
    the old <Private>false</Private>) - the actual DLLs the game loads at
    runtime still come from the real Bannerlord install and the Steam
    Workshop mods declared in SubModule.xml, exactly as before.

    Bannerlord.ReferenceAssemblies.* versions are pinned to the exact game
    build this mod targets (v1.4.8, matching SubModule.xml's
    DependedModuleMetadata) - BUTR publishes one version per game build, so
    there is no API-drift risk from picking a newer/older game version by
    accident. Lib.Harmony/MCM/ButterLib/UIExtenderEx are independent
    libraries (not tied to a game build), pinned to a recent stable release.
  -->
  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.SandBox" Version="1.4.8.119303" PrivateAssets="all" ExcludeAssets="runtime" />

    <PackageReference Include="Lib.Harmony" Version="2.3.3" PrivateAssets="all" ExcludeAssets="runtime" />

    <!--
      Bannerlord.MCM (MCMv5.dll) is the only MCM assembly the code actually
      uses (MCM.Abstractions.*/MCM.Common in ZombiePlagueSettings.cs) - the
      previous separate Bannerlord.MBOptionScreen.dll HintPath (the old v2
      API) was dead weight, no file referenced its namespace.
    -->
    <PackageReference Include="Bannerlord.MCM" Version="5.12.3" PrivateAssets="all" ExcludeAssets="runtime" />

    <!--
      Not referenced by any code (nothing uses Bannerlord.ButterLib.* or
      Bannerlord.UIExtenderEx.* namespaces) - kept as compile references only
      for parity with SubModule.xml's DependedModules, in case future code
      needs them. Both are still required there for MCM's UI screen to load
      at runtime regardless of this compile-time reference.
    -->
    <PackageReference Include="Bannerlord.ButterLib" Version="2.11.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
